---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { i18n } from '../i18n';

const { lang, t, href } = i18n(Astro.url.pathname);
const alternates = { en: '/404/', id: '/id/404/' };
---
<!doctype html>
<html lang={lang}>
 <head>
  <BaseHead title={t('Page not found — adisr.')} description={t('This page could not be found. Return home or browse the journal.')} noindex alternates={alternates} />
 </head>
 <body>
  <Header alternates={alternates} />
  <main id="main" class="container not-found">
   <p class="eyebrow">{t('Error 404')}</p>
   <span class="error-code" aria-hidden="true">404<span>.</span></span>
   <h1>{t('Page not found.')}</h1>
   <p class="explanation">{t('The link may be outdated, or the address may have been mistyped. You can head home or find something to read in the journal.')}</p>
   <div class="recovery-actions">
    <a class="button" href={href('/')}><Icon name="arrow-left" size={18} />{t('Back to home')}</a>
    <a class="text-link" href={href('/blog/')}>{t('Browse the journal')}<Icon name="arrow-right" size={18} /></a>
   </div>
  </main>
  <Footer />
 </body>
</html>
<style>
 .not-found{padding-block:72px 96px;min-height:calc(100svh - 300px)}
 .eyebrow{color:var(--accent)}
 .error-code{display:block;margin-block:24px;font:500 clamp(100px,16vw,200px)/1 var(--font-display);letter-spacing:-.08em}
 .error-code>span{color:var(--accent)}
 h1{font-size:clamp(36px,5vw,56px)}
 .explanation{max-width:52ch;margin-top:24px;font-size:18px}
 .recovery-actions{display:flex;flex-wrap:wrap;align-items:center;gap:20px 32px;margin-top:32px}
 .recovery-actions a{min-height:48px}
 @media(max-width:800px){.not-found{padding-block:48px 64px}}
 @media(max-width:480px){.explanation{font-size:16px}.recovery-actions{align-items:flex-start;flex-direction:column}.recovery-actions .button{width:100%}}
</style>
