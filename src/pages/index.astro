---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Dashboard from '../assets/portofolio/optik-system-beranda.png';
import { SITE_DESCRIPTION, SITE_TITLE, PROFILE } from '../consts';
const posts = (await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
---
<!doctype html>
<html lang="en">
<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}/></head>
<body>
<Header/>
<main id="main">
 <section class="container hero" aria-labelledby="hero-title">
  <div class="hero-main">
   <div class="hero-copy"><div class="eyebrow"><span class="status-dot"></span> Software engineer & curious builder</div>
    <h1 id="hero-title">Building useful<br/>things. <span>Sharing<br/>what I learn.</span><span class="period">*</span></h1>
    <p>I’m Adi. I turn complex problems into thoughtful web experiences — and write about the ideas along the way.</p>
    <div class="hero-actions"><a href="#work" class="button">Explore my work <Icon name="arrow-up-right" size={17}/></a><a href="/blog/" class="hero-writing">Read the journal <Icon name="arrow-right" size={16}/></a></div>
   </div>
   <div class="hero-visual" aria-label="An illustration of the process: understand, build, and refine" role="img">
    <div class="visual-header"><span>A LITTLE THOUGHT. A LOT OF CRAFT.</span><span>↗</span></div>
    <div class="diagram"><div class="diagram-axis horizontal"></div><div class="diagram-axis vertical"></div><div class="diagram-circle circle-one"></div><div class="diagram-circle circle-two"></div><div class="diagram-square"></div><span class="diagram-center">✳</span><span class="diagram-tag tag-one">01 / UNDERSTAND</span><span class="diagram-tag tag-two">02 / BUILD</span><span class="diagram-tag tag-three">03 / REFINE</span><span class="cross cross-one">+</span><span class="cross cross-two">+</span></div>
    <div class="visual-footer"><span>Good software starts<br/>with better questions.</span><span class="visual-coordinate">IDEA → IMPACT<br/><span>ITERATION, ALWAYS.</span></span></div>
   </div>
  </div>
  <div class="hero-bottom"><span>A space for work, words, and things worth exploring.</span><span class="scroll-note">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></span></div>
 </section>
 <section id="work" class="container section work-section" aria-labelledby="work-title">
  <div class="section-heading"><div><div class="eyebrow"><span class="number">01</span> Selected work</div><h2 id="work-title">Made for the real world.</h2></div><span class="section-note">Considered interfaces. Practical systems.</span></div>
  <a class="featured-project" href="/work/optik-siliwangi/">
   <div class="project-visual"><div class="project-label"><span class="project-logo">◉</span> OPTIK SILIWANGI <span class="project-visual-label">OPERATIONS, IN FOCUS.</span></div><div class="browser-frame"><div class="browser-toolbar"><span></span><span></span><span></span><div>Optik Siliwangi / Workspace</div><Icon name="plus" size={12}/></div><Image src={Dashboard} alt="Optik Siliwangi operations dashboard with branch filters, order status, and sales summaries" width={1000} loading="eager"/></div><span class="project-image-note">A CLEARER VIEW OF EVERYDAY OPERATIONS</span></div>
   <div class="project-copy"><div class="eyebrow">Featured project <span>2026</span></div><div><h3>Optik<br/> Siliwangi<span>↗</span></h3><p>Connecting the moving parts of optical retail — from store operations to eye examination bookings.</p><div class="project-tags"><span class="pill">Full-stack development</span><span class="pill">Laravel</span><span class="pill">Astro</span></div></div><span class="project-cta">Explore the case study <Icon name="arrow-up-right" size={19}/></span></div>
  </a>
 </section>
 <section class="writing-section" aria-labelledby="writing-title"><div class="container section">
  <div class="section-heading"><div><div class="eyebrow"><span class="number">02</span> The journal</div><h2 id="writing-title">A few things worth sharing.</h2></div><a href="/blog/" class="text-link">All writing <Icon name="arrow-up-right" size={16}/></a></div>
  <p class="writing-intro">Notes on engineering, product decisions, and the craft of making things.<span>New editorial drafts, open for a first read.</span></p>
  <div class="article-grid">{posts.map((post,index)=><ArticleCard post={post} index={index}/>)}</div>
 </div></section>
 <section class="container section about-strip" aria-labelledby="about-title"><div><div class="eyebrow"><span class="number">03</span> The person behind the pixels</div><h2 id="about-title">Engineer by practice.<br/><span>Curious by nature.</span></h2></div><div class="about-strip-copy"><p>I care about how software works, how it feels, and how it fits into someone’s day. This is where I connect those dots through projects and writing.</p><a href="/about/" class="text-link">A little more about me <Icon name="arrow-up-right" size={16}/></a></div></section>
 <section class="container contact-section" aria-labelledby="contact-title"><div><div class="eyebrow">Have something in mind?</div><h2 id="contact-title">Good things start<br/>with a conversation<span>.</span></h2></div><a href={PROFILE.github} class="contact-link" target="_blank" rel="noopener noreferrer" aria-label="Connect with Adi on GitHub"><Icon name="arrow-up-right" size={45}/></a><div class="contact-bottom"><p>A project, an idea, or a shared curiosity. Let’s connect.</p><a href={PROFILE.github} target="_blank" rel="noopener noreferrer">Find me on GitHub <Icon name="arrow-up-right" size={14}/></a></div></section>
</main>
<Footer/>
</body></html>
<style>
 .hero{padding-top:68px}.hero-main{display:grid;grid-template-columns:1.45fr 1fr;gap:55px;align-items:center}.hero .eyebrow{font-size:10px;letter-spacing:.12em}.status-dot{width:6px;height:6px;border-radius:50%;background:var(--accent)}h1{font-size:clamp(56px,6.5vw,86px);font-weight:500;line-height:1.06;margin:27px 0 26px;letter-spacing:-.065em;position:relative}h1>span:not(.period){color:var(--muted)}h1 .period{display:inline-block;color:var(--accent);font-size:62px;vertical-align:top;line-height:.9;margin-left:7px}.hero-copy>p{max-width:405px;font-size:14px;line-height:1.9}.hero-actions{display:flex;gap:28px;align-items:center;margin-top:32px}.hero-writing{display:flex;align-items:center;gap:12px;font-size:12px;font-weight:500}.hero-writing:hover{color:var(--accent)}.hero-visual{height:420px;background:var(--green);border-radius:3px;display:flex;flex-direction:column;padding:24px;position:relative;overflow:hidden;background-image:radial-gradient(#7b896528 .8px,transparent .8px);background-size:16px 16px}.visual-header{display:flex;justify-content:space-between;color:var(--muted);font:8px var(--font-display);letter-spacing:.07em}.visual-header>span:last-child{font-size:20px;line-height:.8}.diagram{height:280px;position:relative;width:100%;margin:8px auto}.diagram-axis{position:absolute;background:var(--ink);opacity:.12}.horizontal{height:1px;width:100%;top:50%}.vertical{width:1px;height:100%;left:50%}.diagram-circle{width:175px;height:175px;border:1px solid #68735a;position:absolute;left:50%;top:50%;border-radius:50%}.circle-one{transform:translate(-70%,-60%)}.circle-two{transform:translate(-30%,-35%)}.diagram-square{width:128px;height:128px;border:1px solid #68735a;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(45deg);background:#dce4d61a}.diagram-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:98px;line-height:1;color:var(--accent);font-family:Arial,sans-serif}.diagram-tag{position:absolute;background:var(--paper);padding:7px 10px;font:8px var(--font-display);letter-spacing:.07em;box-shadow:0 3px 8px #00000005}.tag-one{left:5%;top:17%}.tag-two{right:0;top:48%}.tag-three{left:18%;bottom:9%}.cross{position:absolute;font-size:18px;color:#69745f}.cross-one{right:25px;top:25px}.cross-two{bottom:22px;left:18px}.visual-footer{margin-top:auto;display:flex;justify-content:space-between;align-items:end;font-family:var(--font-display);font-size:13px;line-height:1.4;letter-spacing:-.02em}.visual-coordinate{font-size:8px;line-height:2;text-align:right;letter-spacing:.08em}.visual-coordinate>span{color:var(--muted)}.hero-bottom{border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;padding:42px 0 25px;margin-top:20px;font-size:11px;color:var(--muted)}.scroll-note{font-size:8px;letter-spacing:.12em;display:flex;gap:25px;align-items:center}.scroll-note>span{font-size:20px}.section-note{font-size:11px;color:var(--muted);padding-bottom:5px}.work-section{padding-top:65px}.featured-project{display:grid;grid-template-columns:1.65fr 1fr;border:1px solid var(--line);border-radius:4px;overflow:hidden}.project-visual{background:#dbe5df;min-width:0;padding:30px 28px 0;position:relative;overflow:hidden;color:#24463e}.project-label{display:flex;align-items:center;gap:8px;font:9px var(--font-display);letter-spacing:.06em}.project-logo{font-size:20px}.project-visual-label{margin-left:auto;font-size:7px;letter-spacing:.14em}.browser-frame{margin:40px -50px 0 20px;transform:rotate(-3deg);border:1px solid #b7cac0;box-shadow:0 16px 45px #224c3524;border-radius:6px 6px 0 0;overflow:hidden;background:white;transition:transform .5s}.featured-project:hover .browser-frame{transform:rotate(-1deg) translateY(-5px)}.browser-toolbar{display:flex;gap:4px;align-items:center;padding:10px 12px;background:#f6f8f5;border-bottom:1px solid #e0e5df;color:#788a7b}.browser-toolbar>span{width:4px;height:4px;border-radius:50%;background:#bac8bf}.browser-toolbar>div{font-size:7px;text-align:center;flex:1}.browser-frame img{width:100%;height:310px;object-fit:cover;object-position:top}.project-image-note{position:absolute;bottom:12px;left:20px;font:7px var(--font-display);letter-spacing:.15em;background:#dbe5dfdd;padding:5px 8px}.project-copy{padding:30px 35px;display:flex;flex-direction:column;justify-content:space-between;gap:36px}.project-copy .eyebrow{font-size:8px;justify-content:space-between;color:var(--muted)}.project-copy h3{font-size:48px;line-height:1.05;position:relative}.project-copy h3>span{position:absolute;right:0;top:5px;font-size:30px;color:var(--muted);transition:transform .2s}.featured-project:hover h3>span{transform:translate(3px,-3px);color:var(--accent)}.project-copy p{font-size:13px;margin-top:20px;line-height:1.8;max-width:260px}.project-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:20px}.project-tags .pill{font-size:8px}.project-cta{border-top:1px solid var(--line);padding-top:18px;display:flex;justify-content:space-between;align-items:center;font-size:11px;font-weight:500}.writing-section{background:var(--surface);border-block:1px solid var(--line)}.writing-intro{font-size:13px;margin-top:-12px;margin-bottom:30px;display:flex;justify-content:space-between;gap:20px}.writing-intro>span{font-size:10px;align-self:end}.article-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px}.about-strip{display:grid;grid-template-columns:1.1fr 1fr;gap:70px;align-items:center}.about-strip h2{font-size:42px;margin-top:23px;line-height:1.2}.about-strip h2>span{color:var(--muted)}.about-strip-copy{padding-top:25px}.about-strip-copy p{font-size:15px;line-height:1.85;max-width:410px}.about-strip-copy .text-link{margin-top:20px}.contact-section{padding:47px;background:var(--accent-soft);display:grid;grid-template-columns:1fr auto;margin-bottom:75px;border-radius:4px}.contact-section .eyebrow{font-size:9px;color:var(--accent)}.contact-section h2{font-size:48px;line-height:1.12;margin-top:18px}.contact-section h2>span{color:var(--accent)}.contact-link{width:86px;height:86px;border:1px solid var(--ink);border-radius:50%;display:grid;place-items:center;align-self:center;transition:background .2s}.contact-link:hover{background:var(--ink);color:var(--paper)}.contact-bottom{grid-column:1/-1;display:flex;justify-content:space-between;gap:20px;margin-top:35px;padding-top:22px;border-top:1px solid var(--line)}.contact-bottom p,.contact-bottom a{font-size:11px}.contact-bottom a{display:flex;align-items:center;gap:10px}
 @media(max-width:1000px){.hero-main{gap:30px;grid-template-columns:1.4fr 1fr}h1{font-size:65px}.hero-visual{height:380px;padding:20px}.diagram-circle{width:145px;height:145px}.diagram-square{width:100px;height:100px}.diagram-center{font-size:80px}.tag-one{left:0}.tag-three{left:0}.hero-actions{gap:20px}.project-copy{padding:25px}.project-copy h3{font-size:40px}.project-visual-label{display:none}.writing-intro>span{display:none}.about-strip{gap:35px}.about-strip h2{font-size:36px}}
 @media(max-width:800px){.hero{padding-top:45px}.hero-main{grid-template-columns:1fr 0.85fr;gap:22px}h1{font-size:55px}h1 .period{font-size:40px}.hero .eyebrow{font-size:8px}.hero-visual{height:350px;padding:16px}.visual-header{font-size:6px}.visual-footer{font-size:10px}.visual-coordinate{font-size:6px}.diagram-circle{width:125px;height:125px}.diagram-tag{font-size:6px;padding:6px}.hero-actions{flex-wrap:wrap;gap:15px}.hero-copy>p{font-size:13px}.hero-actions .button{font-size:11px;padding:12px 16px}.hero-writing{font-size:11px}.project-copy{padding:24px;gap:24px}.featured-project{grid-template-columns:1.2fr 1fr}.project-copy h3{font-size:35px}.project-copy p{font-size:12px}.article-grid{gap:20px}.contact-section{padding:32px}.contact-section h2{font-size:40px}}
 @media(max-width:650px){.hero-main{grid-template-columns:1fr;gap:35px}h1{font-size:clamp(52px,11.8vw,77px);margin-block:24px}.hero .eyebrow{font-size:9px}.hero-copy>p{max-width:370px;font-size:14px}.hero-actions{gap:25px}.hero-actions .button{font-size:12px;padding:14px 18px}.hero-visual{height:330px;max-width:none}.diagram{height:235px}.diagram-circle{width:150px;height:150px}.diagram-square{width:110px;height:110px}.diagram-center{font-size:90px}.visual-header{font-size:8px}.visual-footer{font-size:13px}.visual-coordinate{font-size:7px}.diagram-tag{font-size:8px}.tag-one{left:12%}.tag-two{right:6%}.tag-three{left:20%}.hero-bottom{margin-top:0;padding-top:28px}.hero-bottom>span:first-child{max-width:220px;font-size:10px}.scroll-note{font-size:0;gap:0}.section-note{display:none}.featured-project{grid-template-columns:1fr}.project-visual{height:300px}.browser-frame{margin-top:25px}.project-copy{padding:27px;gap:28px}.project-copy h3{font-size:42px}.project-copy h3 br{display:none}.project-copy p{max-width:none;font-size:14px}.project-copy .eyebrow{font-size:9px}.project-tags .pill{font-size:9px}.article-grid{grid-template-columns:1fr;gap:40px}.about-strip{grid-template-columns:1fr;gap:20px}.about-strip-copy{padding-top:0}.about-strip h2{font-size:37px}.contact-section{padding:27px;position:relative}.contact-section h2{font-size:33px}.contact-link{width:50px;height:50px;align-self:start;margin-top:40px;margin-left:5px}.contact-link svg{width:28px}.contact-bottom{flex-direction:column;gap:15px}.contact-section{margin-bottom:50px}.writing-intro{font-size:13px;max-width:300px}}
@media(max-width:650px){.contact-section{display:block}.contact-link{position:absolute;top:20px;right:20px;width:35px;height:35px;margin:0}.contact-link svg{width:23px}.contact-section .eyebrow{max-width:200px}}
</style>
