---
import { i18n } from '../i18n';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import {PROFILE} from '../consts';

const { lang, t, href } = i18n(Astro.url.pathname);---
<!doctype html><html lang={lang}><head><BaseHead title={t("About Adi — adisr.")} description={t("A closer look at Adi’s approach to software, thoughtful interfaces, and sharing the work.")}/></head><body><Header/><main id="main" class="container">
<section class="page-intro"><div class="eyebrow">{t("A little about me")}</div><h1>{t("Hello, I’m Adi")}<span>.</span><br/><span class="muted">{t("I like connecting the dots.")}</span></h1><p>{t("Between a problem and a useful product.")}<br/>{t("Between the code and the person using it.")}</p></section>
<section class="about-body section"><div class="about-art" aria-hidden="true"><div class="art-top">{t("THE PERSON BEHIND THE PIXELS")} <span>↗</span></div><span class="large-monogram">a<span>.</span></span><div class="art-bottom"><span>{t("SOFTWARE / SYSTEMS / IDEAS")}</span><span>{t("Always curious.")}</span></div></div><div class="about-prose prose"><h2>{t("Thoughtful software.")}<br/>{t("Practical purpose.")}</h2><p>{t("I’m a software engineer with an interest in the whole experience: the system behind an interface, the decisions it makes visible, and the small details that make it easier to use.")}</p><p>{t("My portfolio includes")} <a href={href("/work/optical-management-system/")}>Optical Management System</a>{t(", bringing clarity, accountability, and continuity across the full optical retail process, and")} <a href={href("/work/order-system/")}>Order System</a>{t(", a wholesale spare-parts platform with product search, customer pricing, and bulk ordering. Both explore how software can support the details of everyday business.")}</p><p>{t("This site is a place to show the work and make room for the thinking around it. The journal explores engineering, product decisions, and the process of building something useful.")}</p><div class="about-contact"><a class="button" href={PROFILE.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="message" size={17}/> {t("Chat on WhatsApp")}</a><a class="text-link" href={PROFILE.github} target="_blank" rel="noopener noreferrer">{t("Find me on GitHub")} <Icon name="arrow-up-right" size={17}/></a></div></div></section>
<section class="principles section"><div class="eyebrow"><span class="number">{t("An approach to the work")}</span></div><div class="principle-grid"><div><span class="principle-number">01 /</span><h2>{t("Understand first.")}</h2><p>{t("Start with the person, the problem, and the context. Good questions give the work a direction.")}</p></div><div><span class="principle-number">02 /</span><h2>{t("Make it clear.")}</h2><p>{t("Use considered structure, precise language, and interfaces that make the next step feel natural.")}</p></div><div><span class="principle-number">03 /</span><h2>{t("Keep refining.")}</h2><p>{t("Build, inspect, and improve. Leave space to learn something the first version could not tell you.")}</p></div></div></section>
<section class="about-next"><div><div class="eyebrow">{t("Less introduction. More exploration.")}</div><h2>{t("See the work.")}<br/><span>{t("Read the thinking.")}</span></h2></div><div><a href={href("/work/optical-management-system/")} class="button">{t("Explore the portfolio")} <Icon name="arrow-up-right" size={17}/></a><a href={href("/blog/")} class="text-link">{t("Visit the journal")} <Icon name="arrow-right" size={17}/></a></div></section>
</main><Footer/></body></html>
<style>
 h1>span{color:var(--accent)}h1>.muted{color:var(--muted)}.page-intro h1{font-size:clamp(43px,5.7vw,76px)}.about-body{display:grid;grid-template-columns:.85fr 1.2fr;gap:100px;align-items:start}.about-art{background:var(--green);height:470px;padding:25px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:50px 50px}.art-top{display:flex;justify-content:space-between;font:8px var(--font-display);letter-spacing:.1em}.large-monogram{font:500 270px/.8 var(--font-display);letter-spacing:-.1em;align-self:center;padding-right:30px}.large-monogram>span{color:var(--accent)}.art-bottom{display:flex;justify-content:space-between;gap:10px;align-items:end;font-size:8px}.art-bottom>span:last-child{font:15px var(--font-display)}.about-prose h2{margin-top:0;font-size:37px}.about-prose p{font-size:16px}.about-prose .text-link{font-size:12px;text-decoration:none}.principles{border-top:1px solid var(--line);padding-top:40px}.principle-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:50px;margin-top:35px}.principle-number{font:10px var(--font-display);color:var(--muted)}.principle-grid h2{font-size:27px;margin-block:18px 15px}.principle-grid p{font-size:13px;line-height:1.85}.about-next{background:var(--surface);padding:40px;margin-bottom:70px;display:flex;justify-content:space-between;align-items:center;gap:30px;border:1px solid var(--line)}.about-next .eyebrow{font-size:9px}.about-next h2{font-size:40px;margin-top:20px}.about-next h2 span{color:var(--muted)}.about-next>div:last-child{display:flex;flex-direction:column;align-items:start;gap:15px}
 @media(max-width:1000px){.about-body{gap:45px}.about-art{height:400px}.large-monogram{font-size:220px}.about-prose h2{font-size:32px}.principle-grid{gap:30px}}@media(max-width:650px){.about-body{grid-template-columns:1fr;gap:40px}.about-art{height:350px}.large-monogram{font-size:230px}.principle-grid{grid-template-columns:1fr;gap:30px}.principle-grid h2{margin-top:10px}.about-next{padding:27px;flex-direction:column;align-items:start}.about-next h2{font-size:35px}}
.about-contact{display:flex;flex-wrap:wrap;align-items:center;gap:20px;margin-top:26px}.about-contact .button{color:var(--paper);text-decoration:none}.about-contact .button:hover{color:#fff}
</style>
