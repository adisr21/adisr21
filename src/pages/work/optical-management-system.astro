---
import { i18n } from '../../i18n';
import {Image} from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import Dashboard from '../../assets/portofolio/optik-system-beranda.png';
import Booking from '../../assets/portofolio/optik-system-booking.png';

const { lang, t, href } = i18n(Astro.url.pathname);---
<!doctype html><html lang={lang}><head><BaseHead title={t("Optical Management System — A project by Adi")} description={t("An optical management system built for clear processes, accountable decisions, and continuity across the full operation, from examination booking to collection.")} image={Dashboard}/></head><body><Header/><main id="main" class="container">
<section class="case-intro"><a href={href("/#work")} class="back-link"><Icon name="arrow-left" size={15}/> {t("Selected work")}</a><div class="eyebrow">{t("Portfolio / Web application / 2026")}</div><h1>Optical Management System<span>.</span></h1><p class="case-subtitle">{t("Clear processes.")}<br/><span>{t("Accountable operations.")}</span></p><div class="case-meta"><div><span>{t("Project")}</span><strong>Optical Management System</strong></div><div><span>{t("Focus")}</span><strong>{t("Clarity, accountability & continuity")}</strong></div><div><span>{t("Built with")}</span><strong>Laravel · PostgreSQL · Astro</strong></div></div></section>
<figure class="case-image"><div class="image-toolbar"><span>OPTICAL MANAGEMENT SYSTEM</span><span>{t("01 / OPERATIONS OVERVIEW")}</span></div><Image src={Dashboard} alt={t("Optical Management System dashboard showing branch and date filters, lens order statuses, and financial summaries")} width={1400} loading="eager"/><figcaption>{t("A shared view of branch activity makes operational status and outstanding work visible to the team.")}</figcaption></figure>
<section class="case-section"><div><div class="eyebrow"><span class="number">01</span> {t("The context")}</div><h2>{t("The process should live")}<br/>{t("in the system.")}</h2></div><div class="prose"><p>{t("When operational knowledge lives with one person, each handoff depends on their memory and availability. The business needs a shared process that makes the next step, the responsible role, and the history of each action clear.")}</p><p>{t("Optical Management System connects examination bookings, customer records, prescriptions, sales, payments, inventory, lens fulfillment, and collection. Shared rules and visible statuses let another authorized team member continue the work with its context intact.")}</p></div></section>
<section class="case-section"><div><div class="eyebrow"><span class="number">02</span> {t("The approach")}</div><h2>{t("Make the work clear.")}<br/>{t("Make decisions traceable.")}</h2></div><div class="decisions"><div><span>01</span><div><h3>{t("Make the next step clear.")}</h3><p>{t("Explicit statuses show where a booking, payment, or lens order stands. Staff can see what is waiting, what needs attention, and which step follows.")}</p></div></div><div><span>02</span><div><h3>{t("Make decisions accountable.")}</h3><p>{t("Role-based access, approval steps, and audit history connect operational decisions to the people responsible for them. Branch context keeps each action within its proper scope.")}</p></div></div><div><span>03</span><div><h3>{t("Carry context through each handoff.")}</h3><p>{t("Linked records preserve the details from examination and sale through payment, fulfillment, and collection. The next team member can work from the recorded state and history of the process.")}</p></div></div></div></section>
<figure class="case-image booking-image"><div class="image-toolbar"><span>OPTICAL MANAGEMENT SYSTEM</span><span>{t("02 / EXAMINATION BOOKING")}</span></div><Image src={Booking} alt={t("Optical Management System public branch selection and examination booking interface")} width={1400}/><figcaption>{t("The public booking flow captures branch, schedule, and contact details before the team takes over.")}</figcaption></figure>
<section class="case-section"><div><div class="eyebrow"><span class="number">03</span> {t("Under the surface")}</div><h2>{t("Shared rules.")}<br/>{t("A complete operational record.")}</h2></div><div class="prose"><p>{t("Laravel holds the operational rules for scheduling, sales, payment verification, stock movements, and fulfillment. Permissions, validation, and approval requirements are enforced by the system at the point of action.")}</p><p>{t("Astro provides the public entry point for branch information and examination requests. Inside the business, connected records and audit history preserve the context needed to follow the process through to collection.")}</p><div class="stack"><span class="pill">Laravel</span><span class="pill">PostgreSQL</span><span class="pill">Astro</span><span class="pill">{t("Role-based access")}</span><span class="pill">{t("Audit history")}</span></div></div></section>
<section class="flow-section"><div class="eyebrow">{t("One connected process, from first contact to collection")}</div><div class="flow"><div><span>{t("EXAMINATION & SALE")}</span><h3>{t("Book. Examine.")}<br/>{t("Record the sale.")}</h3><p>{t("Customer, prescription & order context")}</p></div><span class="flow-arrow" aria-hidden="true">→</span><div><span>{t("CONTROL & RESPONSIBILITY")}</span><h3>{t("Approve. Validate.")}<br/>{t("Keep the history.")}</h3><p>{t("Payments, permissions & inventory")}</p></div><span class="flow-arrow" aria-hidden="true">→</span><div><span>{t("FULFILLMENT & COLLECTION")}</span><h3>{t("Track progress.")}<br/>{t("Complete the handoff.")}</h3><p>{t("Lens orders, readiness & collection")}</p></div></div></section>
<section class="case-section next-questions"><div><div class="eyebrow"><span class="number">04</span> {t("Business impact")}</div><h2>{t("Clear ownership.")}<br/>{t("Continuity across the team.")}</h2></div><div class="prose"><p>{t("The business gains a shared understanding of what is happening, what needs to happen next, and who is accountable. Decisions and changes have a recorded history that the team can follow.")}</p><p>{t("The system carries the rules and context across the whole process. Work can continue when a particular person is unavailable, because the next authorized team member has the information and structure needed to take over.")}</p><a href={href("/blog/designing-for-the-unhappy-path/")} class="text-link">{t("Related note: designing for the unhappy path")} <Icon name="arrow-up-right" size={16}/></a></div></section>
<div class="case-end"><a href={href("/#work")} class="text-link"><Icon name="arrow-left" size={16}/> {t("Back to the portfolio")}</a><a href={href("/blog/")} class="text-link">{t("Explore the journal")} <Icon name="arrow-up-right" size={16}/></a></div>
</main><Footer/></body></html>
<style>
 .case-intro{padding:45px 0 40px}.back-link{display:inline-flex;gap:12px;align-items:center;font-size:11px;color:var(--muted);margin-bottom:44px}.back-link:hover{color:var(--accent)}.case-intro .eyebrow{font-size:10px;color:var(--accent)}h1{font-size:clamp(48px,7vw,94px);margin-top:22px}h1>span{color:var(--accent)}.case-subtitle{font:500 38px/1.25 var(--font-display);letter-spacing:-.04em;color:var(--ink);margin-top:25px}.case-subtitle span{color:var(--muted)}.case-meta{display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:30px;margin-top:45px;padding-top:25px;border-top:1px solid var(--line)}.case-meta>div{display:flex;flex-direction:column;gap:7px}.case-meta span{font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}.case-meta strong{font-size:12px;font-weight:500}.case-image{margin:0;padding:30px;background:#dbe5df;border-radius:4px;color:#24463e}.image-toolbar{display:flex;justify-content:space-between;font:8px var(--font-display);letter-spacing:.1em;margin-bottom:20px}.case-image img{border-radius:4px;box-shadow:0 10px 30px #24463e10;width:100%}.case-image figcaption{font-size:10px;margin-top:20px;color:#486457}.case-section{display:grid;grid-template-columns:1fr 1.3fr;gap:90px;padding-block:70px;border-bottom:1px solid var(--line)}.case-section h2{font-size:35px;margin-top:23px;line-height:1.2}.case-section .eyebrow{font-size:10px}.case-section .prose{font-size:16px}.decisions{display:flex;flex-direction:column;gap:30px}.decisions>div{display:flex;align-items:start;gap:20px}.decisions>div>span{font:10px var(--font-display);color:var(--accent);padding-top:7px}.decisions h3{font-size:23px;margin-bottom:12px}.decisions p{font-size:14px;line-height:1.8}.booking-image{margin-top:65px;background:#e1e5e9;color:#586575}.booking-image figcaption{color:#586575}.stack{display:flex;gap:7px;flex-wrap:wrap;margin-top:25px}.stack .pill{font-size:10px}.flow-section{padding:35px;background:var(--surface);border:1px solid var(--line);margin-top:60px}.flow-section>.eyebrow{font-size:10px;color:var(--muted)}.flow{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:30px}.flow>div>span{font-size:8px;color:var(--accent);letter-spacing:.08em}.flow h3{font-size:23px;line-height:1.3;margin-block:12px}.flow p{font-size:10px}.flow-arrow{font-size:24px;color:var(--muted)}.next-questions{border-bottom:0}.prose .text-link{font-size:11px;text-decoration:none}.case-end{display:flex;justify-content:space-between;margin-bottom:60px;padding-top:20px;border-top:1px solid var(--line)}.case-end .text-link{font-size:11px}
 @media(max-width:900px){.case-section{gap:40px}.case-section h2{font-size:30px}.case-meta{gap:20px}.flow h3{font-size:20px}.flow{gap:12px}.flow-section{padding:25px}}
 @media(max-width:650px){.case-intro{padding-top:30px}.case-subtitle{font-size:28px}.case-meta{grid-template-columns:1fr;gap:20px}.case-image{padding:15px}.image-toolbar{font-size:6px;gap:15px}.case-image figcaption{font-size:9px}.case-section{grid-template-columns:1fr;gap:25px;padding-block:45px}.case-section h2{font-size:31px}.flow{flex-direction:column;align-items:start;gap:20px}.flow-arrow{transform:rotate(90deg);margin-left:35px}.flow>div{width:100%;padding:5px 0}.flow h3 br{display:initial}.flow h3{font-size:23px}.flow h3 br::after{content:' '}.flow-section{margin-top:35px}.case-end{gap:25px;flex-wrap:wrap}.booking-image{margin-top:40px}}
</style>
