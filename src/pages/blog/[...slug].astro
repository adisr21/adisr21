---
import { type CollectionEntry, render } from 'astro:content';
import { postsForLocale, postAlternates } from '../../lib/blog';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await postsForLocale('en');
	return posts.map((post) => ({
		params: { slug: post.data.translationKey },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);
const readingTime = Math.max(1, Math.ceil((post.body ?? '').split(/\s+/).length / 200));
---

<BlogPost {...post.data} alternates={await postAlternates(post)} headings={headings} readingTime={readingTime}>
	<Content />
</BlogPost>
