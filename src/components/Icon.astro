---
interface Props {name: 'arrow-up-right' | 'arrow-right' | 'arrow-left' | 'sun' | 'moon' | 'search' | 'copy' | 'check' | 'plus' | 'message'; size?:number;}
const {name,size=20}=Astro.props;
const paths = {'arrow-up-right':'M7 17 17 7M7 7h10v10','arrow-right':'M4 12h16m-6-6 6 6-6 6','arrow-left':'M20 12H4m6-6-6 6 6 6',sun:'M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5',moon:'M20.8 13A9 9 0 0 1 11 3.2 9 9 0 1 0 20.8 13Z',search:'m21 21-5-5',copy:'M9 9h11v11H9zM15 5V3H3v12h2',check:'m5 12 4 4L19 6',plus:'M12 5v14M5 12h14',message:'M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z'};
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name]}/>{name==='sun'&&<circle cx="12" cy="12" r="4"/>}{name==='search'&&<circle cx="10.5" cy="10.5" r="6.5"/>}</svg>
