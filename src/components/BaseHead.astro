---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { i18n, localizePath, type Alternates } from '../i18n';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

const { lang, t, href } = i18n(Astro.url.pathname);
interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	noindex?: boolean;
	alternates?: Alternates;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, noindex = false, alternates } = Astro.props;
const languagePaths: Alternates = alternates ?? { en: localizePath(Astro.url.pathname, 'en'), id: localizePath(Astro.url.pathname, 'id') };
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8DY1FEL4VF"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-8DY1FEL4VF');
</script>

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={t(SITE_TITLE)}
	href={new URL(href('/rss.xml'), Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="theme-color" content="#f7f6f2" />
<script is:inline>
  try {
    const saved = localStorage.getItem('adisr-theme');
    document.documentElement.dataset.theme = saved === 'dark' || saved === 'light' ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  } catch { document.documentElement.dataset.theme = 'light'; }
</script>

<Font cssVariable="--font-atkinson" />
<link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{Object.entries(languagePaths).map(([language, path]) => <link rel="alternate" hreflang={language} href={new URL(path!, Astro.site)} />)}
{languagePaths.en && <link rel="alternate" hreflang="x-default" href={new URL(languagePaths.en, Astro.site)} />}
<meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
{Object.keys(languagePaths).filter(language => language !== lang).map(language => <meta property="og:locale:alternate" content={language === 'id' ? 'id_ID' : 'en_US'} />)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image?.src ?? '/social-card.png', Astro.site)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
