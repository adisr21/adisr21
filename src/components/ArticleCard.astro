---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import FormattedDate from './FormattedDate.astro';
interface Props {post:CollectionEntry<'blog'>; index?:number;}
const {post,index=0}=Astro.props;
const minutes = Math.max(1,Math.ceil((post.body ?? '').split(/\s+/).length/200));
---
<article class="article-card" data-article data-category={post.data.category} data-search={`${post.data.title} ${post.data.description} ${post.data.category}`.toLowerCase()}>
 <a href={`/blog/${post.id}/`} class="article-art" tabindex="-1" aria-hidden="true" data-variant={index%3}>
  <span class="art-label">FIELD NOTES / {String(index+1).padStart(2,'0')}</span>
  <div class="art-graphic">{index%3===0 ? <><i class="block b1"></i><i class="block b2"></i><i class="block b3"></i><span class="graphic-plus">+</span></> : index%3===1 ? <><i class="orbit o1"></i><i class="orbit o2"></i><i class="orbit o3"></i><i class="orbit-dot"></i></> : <><i class="step s1"></i><i class="step s2"></i><i class="step s3"></i><span class="graphic-arrow">↗</span></>}</div>
  <span class="art-bottom">{post.data.category}<Icon name="arrow-up-right" size={16}/></span>
 </a>
 <div class="article-meta"><span>{post.data.category}</span><span>{minutes} min read</span>{post.data.draft&&<span class="draft">Draft</span>}</div>
 <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
 <p>{post.data.description}</p>
 <div class="article-date"><FormattedDate date={post.data.pubDate}/><a href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}><Icon name="arrow-right" size={17}/></a></div>
</article>
<style>
 .article-card{min-width:0}.article-art{height:230px;display:flex;position:relative;overflow:hidden;background:#e5e8dd;color:#424d38;flex-direction:column;justify-content:space-between;padding:20px 24px;border-radius:3px}.article-art[data-variant='1']{background:#efe2d6;color:#95593c}.article-art[data-variant='2']{background:#e1e5e9;color:#586575}.art-label{font:9px var(--font-display);letter-spacing:.13em}.art-bottom{display:flex;justify-content:space-between;align-items:center;font-size:10px}.art-graphic{position:absolute;inset:35px 0 30px;display:flex;justify-content:center;align-items:center;transition:transform .4s}.article-card:hover .art-graphic{transform:scale(1.05)}.block{width:66px;height:86px;position:absolute;border:1px solid #69745d;transform:skewY(-25deg)}.b1{margin-left:-78px;margin-top:35px;background:#c3ceb8}.b2{margin-top:0;background:#d4ddca}.b3{margin-left:78px;margin-top:-35px;background:#e5e8dd}.graphic-plus{position:absolute;right:55px;top:3px;font:40px var(--font-display);font-weight:400}.orbit{position:absolute;width:116px;height:116px;border:1px solid #b27f5f;border-radius:50%}.o1{margin-left:-60px}.o2{margin-left:60px}.o3{width:116px;height:116px;border-radius:0;transform:rotate(45deg);border-color:#caa789}.orbit-dot{height:14px;width:14px;border-radius:50%;background:#9b5c3b;position:absolute;left:calc(50% + 60px);top:24px}.step{position:absolute;bottom:20px;width:48px;border:1px solid #8794a0;background:#c2ccd5}.s1{height:38px;margin-left:-108px}.s2{height:74px}.s3{height:110px;margin-left:108px}.graphic-arrow{position:absolute;left:calc(50% - 76px);top:-12px;font:74px var(--font-display);color:#5d6c7b}.article-meta{display:flex;align-items:center;gap:12px;font-size:10px;color:var(--muted);margin:23px 0 12px}.article-meta>span:first-child{color:var(--accent)}.draft{font-size:9px;border:1px solid var(--line);border-radius:2px;padding:0 5px}.article-card h3{font-size:24px;line-height:1.25;letter-spacing:-.035em}.article-card h3 a:hover{color:var(--accent)}.article-card p{font-size:13px;line-height:1.75;margin-top:12px}.article-date{display:flex;justify-content:space-between;align-items:center;margin-top:24px;padding-top:17px;border-top:1px solid var(--line);font-size:10px;color:var(--muted)}.article-date>a{display:flex;padding:6px}.article-date>a:hover{color:var(--accent)}
 @media(max-width:1000px){.article-art{height:200px}.article-card h3{font-size:22px}}@media(max-width:650px){.article-art{height:240px}.article-card h3{font-size:26px}}
</style>
