---
import { getLocale } from '../i18n';
const lang = getLocale(Astro.url.pathname);
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString(lang === 'id' ? 'id-ID' : 'en-US', {
		timeZone: 'UTC',
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	})}
</time>
